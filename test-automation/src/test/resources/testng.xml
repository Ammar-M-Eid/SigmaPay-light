<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SigmaPay Test Suite" parallel="classes" thread-count="3" verbose="1">
    
    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl" value="http://localhost:3000"/>
    
    <listeners>
        <listener class-name="com.sigmapay.listeners.TestListener"/>
        <listener class-name="com.sigmapay.listeners.ExtentReportListener"/>
    </listeners>
    
    <!-- Smoke Tests - Critical functionality -->
    <test name="Smoke Tests" group-by-instances="true">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.sigmapay.tests.AuthenticationTests"/>
            <class name="com.sigmapay.tests.BudgetTests"/>
        </classes>
    </test>
    
    <!-- Regression Tests - All functionality -->
    <test name="Regression Tests" enabled="true">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.sigmapay.tests.AuthenticationTests"/>
            <class name="com.sigmapay.tests.BudgetTests"/>
            <class name="com.sigmapay.tests.GoalsTests"/>
            <class name="com.sigmapay.tests.PaymentsTests"/>
            <class name="com.sigmapay.tests.ReportsTests"/>
            <class name="com.sigmapay.tests.GroupSavingsTests"/>
            <class name="com.sigmapay.tests.NotificationsTests"/>
            <class name="com.sigmapay.tests.ProfileTests"/>
        </classes>
    </test>
    
    <!-- UI Tests - Visual validation -->
    <test name="UI Tests" enabled="true">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="com.sigmapay.tests.UITests"/>
        </classes>
    </test>
    
</suite>
